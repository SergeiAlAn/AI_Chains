# --- ProxyAPI (https://proxyapi.ru) ---
PROXYAPI_KEY=sk-your-proxyapi-key
PROXYAPI_BASE_URL=https://api.proxyapi.ru/openai/v1
LLM_MODEL=gpt-4o-mini
# Модель для генерации и ревью кода (пусто = LLM_MODEL). gpt-4o / gpt-4.1 пишут код заметно лучше
LLM_CODE_MODEL=gpt-4o
LLM_TEMPERATURE=0.2

# --- Генерация ---
# Сколько раз review_chain может переделать код, если статическая проверка нашла ошибки
MAX_REVIEW_ATTEMPTS=3
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_FILE=generation.log

# --- Токен для запуска сгенерированного бота (от @BotFather) ---
BOT_TOKEN=123456789:your-telegram-bot-token
